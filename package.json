{
  "name": "conduit-delivery-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local workbench for planning, testing, and reviewing changes to the Conduit sample application.",
  "scripts": {
    "dev": "concurrently --names API,WEB -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --config frontend/vite.config.mjs --host 0.0.0.0",
    "start": "node backend/src/server.js",
    "build": "vite build --config frontend/vite.config.mjs",
    "smoke:full-flow": "node scripts/smokeFullFlow.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react-swc": "^4.2.3",
    "axios": "^1.13.6",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "vite": "^7.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^27.3.0",
    "vitest": "^4.0.18"
  }
}
